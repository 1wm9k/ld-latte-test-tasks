    {
      "parameters": {
        "jsCode": "const truthy = ['true', '1', 'yes', 'да', '+'];\nconst services = $input.all()\n  .map(i => i.json)\n  .filter(r => r.id !== undefined && r.id !== null && String(r.id).trim() !== '')\n  .filter(r => truthy.includes(String(r.active).trim().toLowerCase()));\nconst chatId = $('Telegram Trigger1').first().json.message.chat.id;\nconst inline_keyboard = services.map(s => [{ text: String(s.name), callback_data: String(s.id).trim() }]);\nconst hasServices = services.length > 0;\nconst body = { chat_id: chatId, text: hasServices ? 'Выберите услугу:' : 'К сожалению, сейчас нет доступных услуг. Загляните позже.' };\nif (hasServices) body.reply_markup = { inline_keyboard };\nreturn [{ json: { body, count: services.length } }];"
      },
