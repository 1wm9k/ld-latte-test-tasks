    {
      "parameters": {
        "jsCode": "const truthy = ['true', '1', 'yes', 'да', '+'];\nconst cb = $('Telegram Trigger1').first().json.callback_query;\nconst selectedId = String(cb.data).trim();\nconst found = $input.all()\n  .map(i => i.json)\n  .find(r => r.id !== undefined && String(r.id).trim() === selectedId);\nconst active = found && truthy.includes(String(found.active).trim().toLowerCase());\nreturn [{ json: {\n  queryId: cb.id,\n  chatId: cb.message.chat.id,\n  serviceId: selectedId,\n  text: active ? 'Вы выбрали услугу: ' + found.name : 'Эта услуга больше недоступна. Отправьте /start, чтобы обновить меню.'\n} }];"
      },
      "id": "59e5e370-0afc-4c77-84ad-b776834ab660",
